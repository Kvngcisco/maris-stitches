# ─── Supabase ────────────────────────────────────────────────
# Get these from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── ISR Revalidation ────────────────────────────────────────
# A random secret string used to protect the revalidation endpoint
REVALIDATE_SECRET=change-me-to-something-random

# ─── Site URL ────────────────────────────────────────────────
# Used by next-sitemap for sitemap.xml generation
NEXT_PUBLIC_SITE_URL=https://marisstitches.com
